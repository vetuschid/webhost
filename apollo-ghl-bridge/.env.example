# Apollo MASTER API key (a standard key 403s on /labels and /contacts/search)
APOLLO_MASTER_KEY=

# GoHighLevel sub-account Private Integration Token (Settings -> Private Integrations).
# Scope it to: View/Edit Contacts, View Custom Fields.
GHL_PIT=

# GoHighLevel Location (sub-account) ID. Also settable in config.json; env wins.
GHL_LOCATION_ID=

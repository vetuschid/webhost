# All runtime config is optional — keys are stored encrypted in the DB via the Setup UI.
# These env vars only override defaults.

# Where Lead Sifter stores its master key + SQLite db.
LEAD_SIFTER_HOME=~/.lead-sifter

# CORS allowlist for the frontend dev server(s).
LEAD_SIFTER_CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# Override the default chat-capable model filter regex for OpenAI /v1/models.
# LEAD_SIFTER_OPENAI_MODEL_FILTER=^(gpt-|o)

# Optional: bind host/port for uvicorn (compose sets these).
# HOST=0.0.0.0
# PORT=8000
